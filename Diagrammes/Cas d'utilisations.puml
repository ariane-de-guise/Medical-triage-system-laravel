Patient --> UC3
Infirmière --> UC3
Infirmière --> UC4
Infirmière --> UC5
Infirmière --> UC6
Infirmière --> UC7
Medecin --> UC3
Medecin --> UC4
Medecin --> UC6
Medecin --> UC7
UC2 <. UC1 : <<include>>
@enduml